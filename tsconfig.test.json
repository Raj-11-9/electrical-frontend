{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "incremental": false,
    "outDir": ".test-build",
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "ES2022",
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": [
    "test/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next",
    ".next-production",
    ".test-build"
  ]
}
